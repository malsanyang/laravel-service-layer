{
  "preset": "laravel",
  "rules": {
    "no_superfluous_phpdoc_tags": false,
    "blank_line_before_statement": {
      "statements": ["break", "continue", "declare", "return", "throw", "try"]
    },
    "ordered_class_elements": {
      "order": [
        "use_trait",
        "case",
        "constant_public",
        "constant_protected",
        "constant_private",
        "property_public",
        "property_protected",
        "property_private",
        "construct",
        "method_public",
        "method_protected",
        "method_private"
      ]
    }
  }
}